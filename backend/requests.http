# Sample requests for the Policy API (VS Code REST Client / Visual Studio / Rider).
# Start the API first: see README. Adjust startDate to within 60 days of today.

@baseUrl = http://localhost:7071/api

### OpenAPI document (Swagger UI is at http://localhost:7071/api/swagger/ui)
GET {{baseUrl}}/openapi/v3.json

### Sell a policy (201 Created)
POST {{baseUrl}}/policies
Content-Type: application/json

{
  "reference": "POL-0001",
  "insuranceType": "Household",
  "startDate": "2026-11-20",
  "amount": 325.50,
  "autoRenew": true,
  "paymentType": "Card",
  "property": {
    "addressLine1": "1 High Street",
    "addressLine2": "Little Town",
    "postcode": "AB1 2CD"
  },
  "policyholders": [
    { "firstName": "Jane", "lastName": "Smith", "dateOfBirth": "1985-04-12" }
  ]
}

### Sell the same reference again (409 Conflict)
POST {{baseUrl}}/policies
Content-Type: application/json

{
  "reference": "pol-0001",
  "insuranceType": "BuyToLet",
  "startDate": "2026-11-20",
  "amount": 410.00,
  "paymentType": "DirectDebit",
  "property": { "addressLine1": "2 High Street", "postcode": "AB1 2CD" },
  "policyholders": [ { "firstName": "John", "lastName": "Smith", "dateOfBirth": "1980-01-01" } ]
}

### Retrieve a policy (200 OK)
GET {{baseUrl}}/policies/POL-0001

### Retrieve an unknown policy (404 Not Found)
GET {{baseUrl}}/policies/DOES-NOT-EXIST

### Invalid policy (400 with field errors)
POST {{baseUrl}}/policies
Content-Type: application/json

{
  "reference": "POL-0002",
  "insuranceType": "Household",
  "startDate": "2030-01-01",
  "amount": 0,
  "paymentType": "Cheque",
  "property": { "addressLine1": "", "postcode": "TOOLONG123" },
  "policyholders": [
    { "firstName": "Young", "lastName": "Person", "dateOfBirth": "2015-01-01" },
    { "firstName": "A", "lastName": "B", "dateOfBirth": "1980-01-01" },
    { "firstName": "C", "lastName": "D", "dateOfBirth": "1980-01-01" },
    { "firstName": "E", "lastName": "F", "dateOfBirth": "1980-01-01" }
  ]
}

### Renew a policy (409 until 30 days before its end date; see TimeOverride__Today in the README)
POST {{baseUrl}}/policies/POL-0001/renew
Content-Type: application/json

{
  "amount": 340.00,
  "paymentType": "Card"
}

### Quote the cost of cancelling today (200; nothing is changed)
GET {{baseUrl}}/policies/POL-0001/cancellation-quote

### Quote the cost of cancelling on a given date (use a date from today onwards)
GET {{baseUrl}}/policies/POL-0001/cancellation-quote?cancellationDate=2026-11-25

### Cancel a policy (200 with refunds; use a date from today onwards)
POST {{baseUrl}}/policies/POL-0001/cancel
Content-Type: application/json

{
  "cancellationDate": "2026-11-25"
}

### Cancel it again (409 Conflict)
POST {{baseUrl}}/policies/POL-0001/cancel
Content-Type: application/json

{
  "cancellationDate": "2026-11-26"
}

### Sell an auto-renewing policy paid by cheque (400: not allowed)
POST {{baseUrl}}/policies
Content-Type: application/json

{
  "reference": "POL-0002",
  "insuranceType": "Household",
  "startDate": "2026-11-20",
  "amount": 300.00,
  "autoRenew": true,
  "paymentType": "Cheque",
  "property": { "addressLine1": "3 High Street", "postcode": "AB1 2CD" },
  "policyholders": [ { "firstName": "Sam", "lastName": "Jones", "dateOfBirth": "1980-01-01" } ]
}

### Sell the same policy without auto renew (201: cheque is fine)
POST {{baseUrl}}/policies
Content-Type: application/json

{
  "reference": "POL-0002",
  "insuranceType": "Household",
  "startDate": "2026-11-20",
  "amount": 300.00,
  "autoRenew": false,
  "paymentType": "Cheque",
  "property": { "addressLine1": "3 High Street", "postcode": "AB1 2CD" },
  "policyholders": [ { "firstName": "Sam", "lastName": "Jones", "dateOfBirth": "1980-01-01" } ]
}

### Record a claim on it (200, hasClaims: true)
POST {{baseUrl}}/policies/POL-0002/claims

### Quote again (200, totalRefund 0: a policy with claims gets no refund)
GET {{baseUrl}}/policies/POL-0002/cancellation-quote
